{
  "nome": "dossiê do CI Queue",
  "intencao": "um HTML autocontido que substitua a explicação humana",
  "runs": [
    {
      "nome": "Reconhecimento", "verbo": "reconhecer",
      "porque": "não sabemos quantas specs o pedido toca nem quais arquivos dentro delas importam — desenhar a leitura agora seria chute",
      "extrai": "índice nominal de alvos · contagem de arquivos por alvo · quais se referenciam · o que fica FORA, com nome",
      "dod": "todo item do índice tem citação verbatim do pedido, e o FORA está escrito. Sem isso a ponte não atravessa.",
      "retorno": "{ alvos[], arquivosPorAlvo{}, referencias[], fora[] }",
      "ponte": "o Marco aprova o índice e o FORA · isso vira args do RUN 2",
      "suficiencia": "alvo sem contagem = RUN 1 roda de novo, não segue",
      "fases": [
        {"nome": "Medir", "padrao": "parallel", "agentes": [
          {"nome": "censo:specs",  "papel": "reader", "modelo": "sonnet", "effort": "low",
           "schema": {"nome": "CENSO", "campos": ["alvo", "arquivos", "linhas", "referencias[]", "citacao"]},
           "corrige": "—", "registra": "—"},
          {"nome": "censo:devkit", "papel": "reader", "modelo": "sonnet", "effort": "low",
           "schema": {"nome": "CENSO", "campos": ["alvo", "arquivos", "linhas", "referencias[]", "citacao"]},
           "corrige": "—", "registra": "—"},
          {"nome": "censo:proofs", "papel": "reader", "modelo": "sonnet", "effort": "low",
           "schema": {"nome": "CENSO", "campos": ["alvo", "arquivos", "linhas", "referencias[]", "citacao"]},
           "corrige": "—", "registra": "—"}
        ]}
      ]
    },
    {
      "nome": "Levantamento", "verbo": "levantar",
      "porque": "o índice está fechado; agora é leitura profunda do recorte aprovado — e só dele",
      "extrai": "um shard por alvo com fonte arquivo:linha · o esqueleto do HTML montado, para o RUN 3 não começar do zero",
      "dod": "toda afirmação do shard tem endereço conferível; alvo que falhou aparece como FALTOU, nunca some do índice",
      "retorno": "{ shards[], faltou[], esqueleto, decisoesPendentes[] }",
      "ponte": "o Marco lê UM arquivo, não seis · decide o que falta",
      "suficiencia": "faltou[] vazio, ou cada falta com motivo escrito",
      "excecaoMecanica": "mesma leitura estruturada em 6 specs já nomeadas pelo RUN 1, sem referência cruzada entre elas — o shard de uma não muda o da outra",
      "fases": [
        {"nome": "Ler", "padrao": "pipeline", "agentes": [
          {"nome": "shard:115", "papel": "reader", "modelo": "sonnet", "effort": "medium",
           "schema": {"nome": "SHARD", "campos": ["alvo", "afirmacoes[]", "fonte", "faltou[]"]},
           "corrige": "—", "registra": "shard-115.md"},
          {"nome": "shard:121", "papel": "reader", "modelo": "sonnet", "effort": "medium",
           "schema": {"nome": "SHARD", "campos": ["alvo", "afirmacoes[]", "fonte", "faltou[]"]},
           "corrige": "—", "registra": "shard-121.md"},
          {"nome": "shard:120", "papel": "reader", "modelo": "sonnet", "effort": "medium",
           "schema": {"nome": "SHARD", "campos": ["alvo", "afirmacoes[]", "fonte", "faltou[]"]},
           "corrige": "—", "registra": "shard-120.md"},
          {"nome": "shard:119", "papel": "reader", "modelo": "sonnet", "effort": "medium",
           "schema": {"nome": "SHARD", "campos": ["alvo", "afirmacoes[]", "fonte", "faltou[]"]},
           "corrige": "—", "registra": "shard-119.md"},
          {"nome": "shard:118", "papel": "reader", "modelo": "sonnet", "effort": "medium",
           "schema": {"nome": "SHARD", "campos": ["alvo", "afirmacoes[]", "fonte", "faltou[]"]},
           "corrige": "—", "registra": "shard-118.md"},
          {"nome": "shard:113", "papel": "reader", "modelo": "sonnet", "effort": "medium",
           "schema": {"nome": "SHARD", "campos": ["alvo", "afirmacoes[]", "fonte", "faltou[]"]},
           "corrige": "—", "registra": "shard-113.md"}
        ]},
        {"nome": "Integrar", "padrao": "serial", "agentes": [
          {"nome": "esqueleto", "papel": "integrador", "modelo": "opus", "effort": "high",
           "schema": {"nome": "ESQUELETO", "campos": ["caminho", "secoes[]", "faltou[]", "divergencias[]", "proximoMovimento"]},
           "corrige": "dossie.html", "registra": "integracao-v1.md"}
        ]}
      ]
    },
    {
      "nome": "Redação", "verbo": "redigir",
      "porque": "o conteúdo existe e foi conferido; o que falta é didática",
      "extrai": "o HTML final, revisado e corrigido contra o índice aprovado no RUN 1",
      "dod": "todo item do índice do RUN 1 aparece no HTML, ou está listado como ausente com o motivo",
      "retorno": "{ html, itensAusentes[], caminhos{} }",
      "fases": [
        {"nome": "Escrever", "padrao": "serial", "agentes": [
          {"nome": "redação", "papel": "writer", "modelo": "opus", "effort": "high",
           "schema": "—", "semSchemaPorque": "o produto é o próprio HTML no disco; o relato em prosa não alimenta estágio nenhum",
           "corrige": "dossie.html", "registra": "—"}
        ]},
        {"nome": "Revisar e corrigir", "padrao": "serial", "agentes": [
          {"nome": "rev:índice", "papel": "fixer", "modelo": "opus", "effort": "high",
           "schema": {"nome": "PENDENCIAS", "campos": ["itemAusente", "corrigido", "naoCorrigido[]", "motivo"]},
           "corrige": "dossie.html", "registra": "qa-indice-v1.md"},
          {"nome": "rev:didática", "papel": "fixer", "modelo": "opus", "effort": "high",
           "schema": {"nome": "PENDENCIAS", "campos": ["trecho", "corrigido", "naoCorrigido[]", "motivo"]},
           "corrige": "dossie.html", "registra": "qa-didatica-v1.md"}
        ]}
      ]
    }
  ]
}
